# VoiceStudy AI Environment Configuration

# Application Settings
HOST=0.0.0.0
PORT=8000
ENV=development

# Lyzr Agent Studio V3 Chat API Configuration
# Get your API key and Agent ID from Lyzr Agent Studio: https://agent.lyzr.ai
LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_lyzr_agent_id_here
LYZR_USER_ID=default_student
LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/

# (Optional) Role-Specific Lyzr Agent IDs from Lyzr Studio for Multi-Agent Orchestration
# If using a single shared agent on the free tier, leave these empty and set LYZR_AGENT_ID above.
LYZR_AGENT_ID_MANAGER=agent_manager_id_here
LYZR_AGENT_ID_SUMMARIZER=agent_summarizer_id_here
LYZR_AGENT_ID_ACTION_ITEMS=agent_action_items_id_here
LYZR_AGENT_ID_MEMORY=agent_memory_assistant_id_here
LYZR_AGENT_ID_QUIZ=agent_quiz_id_here

# LLM & Embedding Provider Configuration (OpenAI)
# Required for genuine semantic embeddings (text-embedding-3-small) and GPT-4o execution
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Qdrant Memory Configuration
# Option A (Default Persistent Local Storage): Leave QDRANT_URL empty and set QDRANT_STORAGE_PATH
QDRANT_STORAGE_PATH=./qdrant_data

# Option B (Qdrant Server / Cloud):
# QDRANT_URL=http://localhost:6333
# QDRANT_URL=https://your-cluster-url.qdrant.tech
# QDRANT_API_KEY=your_qdrant_api_key_if_cloud

# Option C (In-Memory for ephemeral testing):
# QDRANT_URL=:memory:

# Omi Wearable Webhook Configuration
# Configured in Omi Mobile App -> Apps / Webhooks -> Custom Webhook URL
# Webhook Endpoint: https://<your-public-host-or-ngrok>/omi/conversation
OMI_API_KEY=omi_api_key_here
OMI_WEBHOOK_SECRET=omi_webhook_secret_here

